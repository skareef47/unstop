# Environment Configuration for PSAI Backend
ENVIRONMENT=development
DEBUG=True
PROJECT_NAME="PSAI — AI-Powered Technical Support Platform"
API_V1_STR=/api/v1
SECRET_KEY=psai-prototype-secret-key-change-in-production-1234567890
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Default to SQLite for zero-setup local prototype and pytest runs:
DATABASE_URL=sqlite:///./psai.db
# PostgreSQL with pgvector (for Docker Compose or production):
# DATABASE_URL=postgresql+psycopg://psai_user:psai_password@localhost:5432/psai_db

# LLM Provider Configuration ("mock", "gemini", "openai", "groq")
LLM_PROVIDER=mock
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
DEFAULT_LLM_MODEL=gemini-2.5-flash

# Embeddings Provider ("local", "gemini", "openai", "mock")
EMBEDDING_PROVIDER=local
EMBEDDING_DIMENSION=384

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Admin / Auth Mock Credentials
ADMIN_API_KEY=psai-admin-secret-key-2026
ADMIN_EMAIL=admin@psai.internal
ADMIN_PASSWORD=adminpassword123

# Diagnostic and Simulation settings
SIMULATE_LATENCY_MS=0
RATE_LIMIT_PER_MINUTE=120
MAX_UPLOAD_SIZE_BYTES=10485760
